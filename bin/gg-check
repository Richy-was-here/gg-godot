#!/usr/bin/env bash
# gg-check <gate> [project_root] [touched files...]
# Deterministic checks for /gg:verify; `docs` checks the .gamedev/ documents (only the given ones when files are passed). Prints "GATE <name>: PASS|FAIL" plus findings; exit 1 on any FAIL.
set -u
gate=${1:-all}
root=${2:-.}
shift 2 2>/dev/null || shift $#
touched=("$@")
cfg="$root/.gamedev/config.md"
godot=$(sed -n 's/^godot_bin: *//p' "$cfg" 2>/dev/null | tr -d '"' )
godot=${godot:-godot}
fail=0

say() { printf '%s\n' "$*"; }
result() { # name status
  say "GATE $1: $2"
  [ "$2" = FAIL ] && fail=1
  return 0
}
project_files() { # all source files, excluding engine and plugin dirs
  find "$root" -type f \( -name '*.gd' -o -name '*.tscn' -o -name '*.tres' -o -name '*.gdshader' \) \
    -not -path '*/.godot/*' -not -path '*/addons/*' -not -path '*/.gamedev/*' -not -path '*/tests/qa/*' \
    | sed "s|^$root/||" | sort
}
file_uid() { # uid of a file: sidecar .uid or header attribute
  if [ -f "$root/$1.uid" ]; then cat "$root/$1.uid"; else sed -n '1s/.*uid="\(uid:\/\/[^"]*\)".*/\1/p' "$root/$1" 2>/dev/null; fi
}
scripts_touched() { # touched .gd files, or all if none given
  if [ ${#touched[@]} -gt 0 ]; then printf '%s\n' "${touched[@]}" | grep '\.gd$'; else project_files | grep '\.gd$'; fi
}

g_load() {
  if ! grep -q '^run/main_scene=' "$root/project.godot" 2>/dev/null; then
    result load FAIL; say "no main scene set in project.godot (run/main_scene); set one, then rerun"; return
  fi
  local out
  out=$("$godot" --headless --path "$root" --quit-after 2 2>&1); local rc=$?
  local bad allow pat
  allow=$(sed -n '/^allowed_warnings:/,/^[a-z_]*:/p' "$cfg" 2>/dev/null | grep -E '^  - ' | sed 's/^  - //' | grep -v '^<')
  bad=$(printf '%s\n' "$out" | grep -E '^(ERROR|WARNING|SCRIPT ERROR|USER ERROR|USER WARNING)')
  while read -r pat; do [ -n "$pat" ] && bad=$(printf '%s\n' "$bad" | grep -vF -- "$pat"); done <<< "$allow"
  bad=$(printf '%s\n' "$bad" | grep -v '^$')
  if [ $rc = 0 ] && [ -z "$bad" ]; then result load PASS; else result load FAIL; say "exit code: $rc"; printf '%s\n' "$out" | head -40; fi
}

g_parse() {
  local f bad=0
  while read -r f; do
    [ -z "$f" ] && continue
    if ! "$godot" --headless --path "$root" --check-only -s "res://$f" >/dev/null 2>&1; then say "parse error: $f"; bad=1; fi
  done < <(scripts_touched)
  [ $bad = 0 ] && result parse PASS || result parse FAIL
}

g_stubs() {
  local f bad=0
  while read -r f; do
    [ -z "$f" ] && continue
    # function whose body is only `pass`
    awk -v F="$f" '
      /^[[:blank:]]*(static[[:blank:]]+)?func[[:blank:]]/ { fn=$0; infn=1; body=0; next }
      infn && /^[[:blank:]]*$/ { next }
      infn && /^[[:blank:]]*#/ { next }
      infn { if ($0 ~ /^[[:blank:]]*pass[[:blank:]]*$/ && body==0) { print "stub (pass-only): " F ": " fn }; infn=0 }
    ' "$root/$f" | sed 's/[[:blank:]]*$//'
    grep -nE 'TODO|FIXME|XXX|not implemented' "$root/$f" | sed "s|^|todo: $f:|"
  done < <(scripts_touched) | tee /tmp/gg_stubs.$$
  [ -s /tmp/gg_stubs.$$ ] && bad=1
  rm -f /tmp/gg_stubs.$$
  [ $bad = 0 ] && result stubs PASS || result stubs FAIL
}

g_leftovers() {
  local bad=0 n
  n=$(find "$root/tests/qa" -type f -not -name '.gdignore' 2>/dev/null | wc -l)
  [ "$n" -gt 0 ] && { say "tests/qa not empty: $n files"; bad=1; }
  find "$root/tests" -type f -not -path '*/tests/qa/*' -not -name '.gdignore' -not -name '*.uid' 2>/dev/null | sed "s|^$root/||" | while read -r f; do
    grep -qF "$f |" "$root/.gamedev/index.md" 2>/dev/null || say "test file not in index (one-off tests belong in tests/qa): $f"
  done | tee /tmp/gg_lt.$$
  [ -s /tmp/gg_lt.$$ ] && bad=1
  rm -f /tmp/gg_lt.$$
  find "$root" -type f \( -name '*.tmp' -o -name '*.bak' -o -name '*.orig' -o -name '*~' \) -not -path '*/.godot/*' | sed "s|^$root/||; s|^|temp file: |" | tee /tmp/gg_lo.$$
  [ -s /tmp/gg_lo.$$ ] && bad=1
  rm -f /tmp/gg_lo.$$
  [ $bad = 0 ] && result leftovers PASS || result leftovers FAIL
}

g_artifacts() {
  local f bad=0 base refs
  # debug prints and commented-out code in touched scripts
  while read -r f; do
    [ -z "$f" ] && continue
    grep -nE '^[[:blank:]]*print(_rich|_debug|err|raw)?\(' "$root/$f" | sed "s|^|print: $f:|"
    grep -nE '^[[:blank:]]*#[[:blank:]]*(var |func |if |for |while |return|print|[A-Za-z_]+\(.*\)[[:blank:]]*$|[A-Za-z_.]+[[:blank:]]*=[^=])' "$root/$f" | awk -F: '$1>2' | sed "s|^|commented code: $f:|"
    # unused signals declared here
    for sig in $(grep -oE '^[[:blank:]]*signal[[:blank:]]+[A-Za-z_0-9]+' "$root/$f" | awk '{print $2}'); do
      refs=$(grep -rlw --include='*.gd' --include='*.tscn' "$sig" "$root" --exclude-dir=.godot --exclude-dir=addons | grep -v "^$root/$f$" | wc -l)
      [ "$refs" = 0 ] && ! grep -qE "$sig\.emit\(|emit_signal\(\"$sig\"" "$root/$f" && say "unused signal: $f: $sig"
    done
  done < <(scripts_touched) | tee /tmp/gg_art.$$
  [ -s /tmp/gg_art.$$ ] && bad=1
  rm -f /tmp/gg_art.$$
  # unreferenced files project-wide
  local main autoloads uid
  main=$(sed -n 's|^run/main_scene="\(.*\)"|\1|p' "$root/project.godot" 2>/dev/null)
  autoloads=$(sed -n 's|^.*="\*\?res://\(.*\)"|\1|p' "$root/project.godot" 2>/dev/null)
  while read -r f; do
    [ -z "$f" ] && continue
    uid=$(file_uid "$f")
    [ "$main" = "res://$f" ] && continue
    [ -n "$uid" ] && [ "$main" = "$uid" ] && continue
    printf '%s\n' "$autoloads" | grep -qxF "$f" && continue
    base=$(basename "$f")
    refs=$(grep -rlF "$base" "$root" --include='*.gd' --include='*.tscn' --include='*.tres' --include='project.godot' --exclude-dir=.godot --exclude-dir=addons --exclude-dir=.gamedev | grep -v "^$root/$f$" | wc -l)
    if [ "$refs" = 0 ] && [ -n "$uid" ]; then
      refs=$(grep -rlF "$uid" "$root" --include='*.gd' --include='*.tscn' --include='*.tres' --include='project.godot' --exclude-dir=.godot --exclude-dir=addons --exclude-dir=.gamedev | grep -v "^$root/$f$" | grep -v "^$root/$f.uid$" | wc -l)
    fi
    [ "$refs" = 0 ] && { say "unreferenced: $f"; bad=1; }
  done < <(project_files)
  [ $bad = 0 ] && result artifacts PASS || result artifacts FAIL
}

g_index() {
  local idx="$root/.gamedev/index.md" bad=0
  [ -f "$idx" ] || { result index FAIL; say "missing $idx"; return; }
  local listed actual
  listed=$(grep -v '^#' "$idx" | awk -F'|' 'NF>=3 {gsub(/^ +| +$/,"",$1); print $1}' | grep -vE '^\.gamedev/' | sort)
  actual=$(project_files)
  comm -13 <(printf '%s\n' "$listed") <(printf '%s\n' "$actual") | sed 's/^/not in index: /' | tee /tmp/gg_ix.$$
  comm -23 <(printf '%s\n' "$listed") <(printf '%s\n' "$actual") | sed 's/^/in index, missing on disk: /' | tee -a /tmp/gg_ix.$$
  [ -s /tmp/gg_ix.$$ ] && bad=1
  rm -f /tmp/gg_ix.$$
  grep -v '^#' "$idx" | awk -F'|' 'NF>=4 {gsub(/ /,"",$4); if ($4!="") print "checked out: " $1 " by " $4}'
  [ $bad = 0 ] && result index PASS || result index FAIL
}

g_aimarks() {
  grep -rn --include='*.gd' --include='*.tscn' --include='*.tres' --include='*.csv' --include='*.json' --include='*.po' -F '[AI]' "$root" --exclude-dir=.godot --exclude-dir=.gamedev | sed "s|^$root/||"
  say "ai-made entries: $(grep -cv '^#' "$root/.gamedev/ai-made.md" 2>/dev/null || echo 0)"
}

doc_wanted() { # doc_wanted <path under .gamedev>: true when no files were given or the file is among them
  [ ${#touched[@]} -eq 0 ] && return 0
  local t; for t in "${touched[@]}"; do [ "${t#./}" = ".gamedev/$1" ] && return 0; done; return 1
}

g_docs() {
  local gd="$root/.gamedev" out f rel
  [ -d "$gd" ] || { result docs FAIL; say "missing $gd"; return; }
  out=$(
    # layout: only the documents of the SPEC layout
    find "$gd" -type f -not -path "$gd/.lock/*" | sed "s|^$gd/||" | grep -vE '^(vision|roadmap|decisions|index|status|human-checks|conventions|ui-spec|ai-made|notes|config)\.md$|^\.gdignore$|^index/[^/]+\.md$|^plans/[^/]+/[^/]+\.md$|^contracts/[^/]+\.md$' | sed 's|^|layout: not a SPEC document: .gamedev/|'
    # decisions: format, length, ids, supersede links
    if [ -f "$gd/decisions.md" ] && doc_wanted decisions.md; then
      awk -F'|' '
        function t(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        /^#/ || /^[ \t]*$/ { next }
        /^D-[0-9]+[ \t]*\|/ { legacy++; next }
        { id=t($1)
          if (NF != 5) { print "decisions:" NR ": " NF " fields, expected 5 (no | inside a decision): " id; next }
          if (id !~ /^(P|M[0-9]+|M[0-9]+-P[0-9]+)-D-[0-9][0-9]+$/) print "decisions:" NR ": id not <scope>-D-NN: " id
          if (id in line) print "decisions:" NR ": duplicate id " id
          line[id]=NR; d=t($3); if (length(d) > 200) print "decisions:" NR ": decision longer than 200 characters: " id
          sup[id]=t($4); by[id]=t($5)
          if (sup[id] !~ /^(-|(P|M[0-9]+|M[0-9]+-P[0-9]+)-D-[0-9]+)$/) print "decisions:" NR ": supersedes is not an id or -: " id
          if (by[id] !~ /^(-|(P|M[0-9]+|M[0-9]+-P[0-9]+)-D-[0-9]+)$/) print "decisions:" NR ": superseded_by is not an id or -: " id }
        END {
          for (id in sup) { s=sup[id]; if (s == "-") continue
            if (!(s in line)) print "decisions: " id " supersedes unknown " s
            else if (by[s] != id) print "decisions: " s " is superseded by " id " but its superseded_by is " by[s] }
          for (id in by) { b=by[id]; if (b != "-" && !(b in line)) print "decisions: " id " superseded_by unknown " b }
          if (legacy) print "decisions: " legacy " lines in the old D-NN format (not checked)" > "/dev/stderr" }
      ' "$gd/decisions.md"
    fi
    # contracts: line length
    for f in "$gd"/contracts/*.md; do
      [ -f "$f" ] || continue; rel=contracts/$(basename "$f"); doc_wanted "$rel" || continue
      awk -v F="$rel" 'length($0) > 160 { print F ":" NR ": line longer than 160 characters" }' "$f"
    done
    # plans: human_checks length
    for f in "$gd"/plans/*/*.md; do
      [ -f "$f" ] || continue; rel=${f#"$gd"/}; doc_wanted "$rel" || continue
      awk -v F="$rel" '/^human_checks:/ { h=1; next } /^[^ ]/ { h=0 } h && /^ *- / { s=$0; sub(/^ *- /, "", s); if (length(s) > 80) print F ":" NR ": human check longer than 80 characters" }' "$f"
    done
    # status: line length, blocker form
    if [ -f "$gd/status.md" ] && doc_wanted status.md; then
      awk '
        length($0) > 120 { print "status:" NR ": line longer than 120 characters" }
        /^blockers:/ { b=1; next } /^[^ ]/ { b=0 }
        b && /^ *- / { s=$0; sub(/^ *- /, "", s); if (s !~ /^</ && s !~ /;/) print "status:" NR ": blocker not in the form <tool or gate> <symptom>; <ids>: " s }
      ' "$gd/status.md"
    fi
    # human checks: format, length, duplicates per phase
    if [ -f "$gd/human-checks.md" ] && doc_wanted human-checks.md; then
      awk -F'|' '
        function t(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
        /^#/ || /^[ \t]*$/ { next }
        { id=t($1); c=t($2); st=t($3)
          if (NF != 3) { print "human-checks:" NR ": " NF " fields, expected 3"; next }
          if (length(c) > 80) print "human-checks:" NR ": criterion longer than 80 characters"
          if (st != "open" && st != "later") print "human-checks:" NR ": status not open or later: " st
          ph=id; if (match(id, /^M[0-9]+-P[0-9]+/)) ph=substr(id, 1, RLENGTH)
          k=ph SUBSEP c; if (k in seen) print "human-checks:" NR ": duplicate of line " seen[k] " in " ph; else seen[k]=NR }
      ' "$gd/human-checks.md"
    fi
    # roadmap: status consistency, open question length
    if [ -f "$gd/roadmap.md" ] && doc_wanted roadmap.md; then
      awk '
        function close_m() { if (m == "") return
          if (ms == "planned" && busy) print "roadmap: " m " is planned but has active or done phases"
          if (ms == "done" && open) print "roadmap: " m " is done but has phases not done" }
        function close_p() { if (p != "" && ps == "active" && sess == "") print "roadmap: " p " is active without a session"; p="" }
        { ind=match($0, /[^ ]/) - 1 }
        oq && ind <= oqi { oq=0 }
        oq && /^ *- / { s=$0; sub(/^ *- /, "", s); if (length(s) > 80) print "roadmap:" NR ": open question longer than 80 characters" }
        /^ *open_questions:/ { oq=1; oqi=ind; next }
        /^  - id: / { close_p(); close_m(); m=$3; ms=""; busy=0; open=0; next }
        /^      - id: / { close_p(); p=$3; ps=""; sess=""; next }
        ind == 4 && /^ *status:/ { ms=$2 }
        ind == 8 && /^ *status:/ { ps=$2; if (ps == "active" || ps == "done") busy=1; if (ps != "done") open=1 }
        ind == 8 && /^ *session:/ { sess=$2 }
        END { close_p(); close_m() }
      ' "$gd/roadmap.md"
    fi
    # language: documents are English (quoted in-game text excepted)
    for f in vision.md roadmap.md decisions.md status.md; do
      [ -f "$gd/$f" ] && doc_wanted "$f" || continue
      grep -nv -e '^#' -e '^name:' "$gd/$f" | sed 's/"[^"]*"//g' \
        | grep -iE '(ä|ö|ü|Ä|Ö|Ü|ß)|(^|[^[:alpha:]])(und|nicht|wird|werden|oder|eine|einen|sind|auch|wenn|dass|kein|keine)([^[:alpha:]]|$)' \
        | cut -d: -f1 | sed "s|^|$f:|; s|$|: not English|"
    done
  )
  if [ -n "$out" ]; then printf '%s\n' "$out"; result docs FAIL; else result docs PASS; fi
}

case "$gate" in
  docs) g_docs ;;
  load) g_load ;;
  parse) g_parse ;;
  stubs) g_stubs ;;
  leftovers) g_leftovers ;;
  artifacts) g_artifacts ;;
  index) g_index ;;
  aimarks) g_aimarks ;;
  all) g_load; g_parse; g_stubs; g_leftovers; g_artifacts; g_index; touched=(); g_docs ;;
  *) say "usage: gg-check load|parse|stubs|leftovers|artifacts|index|aimarks|docs|all [project_root] [touched files...]"; exit 2 ;;
esac
exit $fail
