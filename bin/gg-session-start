#!/usr/bin/env bash
# gg-session-start — SessionStart hook: if the cwd is a gg project, print session id and status.md into context.
input=$(cat)
sid=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
cwd=$(printf '%s' "$input" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
cwd=${cwd:-$PWD}
[ -f "$cwd/.gamedev/status.md" ] || exit 0
echo "gg project detected. session=${sid:-$(date +%Y%m%d-%H%M%S)}"
cat "$cwd/.gamedev/status.md"
echo "Resume with /gg:resume, advance with /gg:next."
