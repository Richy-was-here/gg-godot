#!/bin/sh
# gg-lock acquire|release <project_root> <session_id>
# Atomic mkdir lock for writes to .gamedev/roadmap.md and .gamedev/index.md. The lock records its holder; only the holder may release it.
cmd=$1
root=$2
sid=$3
lock="$root/.gamedev/.lock"

if [ -z "$root" ] || [ -z "$sid" ]; then
  echo "usage: gg-lock acquire|release <project_root> <session_id>" >&2
  exit 2
fi

case "$cmd" in
  acquire)
    i=0
    while ! mkdir "$lock" 2>/dev/null; do
      # break a lock older than 10 minutes (crashed session)
      if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
        rm -rf "$lock"
        continue
      fi
      i=$((i + 1))
      if [ "$i" -ge 60 ]; then
        echo "lock busy: $lock held by $(cat "$lock/owner" 2>/dev/null)" >&2
        exit 1
      fi
      sleep 0.5
    done
    echo "$sid $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$lock/owner"
    ;;
  release)
    [ -d "$lock" ] || exit 0
    holder=$(cut -d' ' -f1 "$lock/owner" 2>/dev/null)
    if [ "$holder" != "$sid" ]; then
      echo "lock held by ${holder:-unknown}, not by $sid: not released" >&2
      exit 1
    fi
    rm -rf "$lock"
    ;;
  *)
    echo "usage: gg-lock acquire|release <project_root> <session_id>" >&2
    exit 2
    ;;
esac
