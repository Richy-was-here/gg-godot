#!/usr/bin/env bash
# gg-qa-guard — plugin PreToolUse hook. Acts only inside the gg-qa subagent: Write/Edit only under tests/qa, Bash only godot runs and tests/qa paths.
# Reads the hook JSON on stdin; exit 2 blocks the call. Other agents and the main session pass through.
input=$(cat)
agent=$(printf '%s' "$input" | sed -n 's/.*"agent_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
case "$agent" in
  gg-qa|*:gg-qa) ;;
  *) exit 0 ;;
esac
tool=$(printf '%s' "$input" | sed -n 's/.*"tool_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
field() { printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\(\([^\"\\\\]\|\\\\.\)*\)\".*/\1/p" | head -1; }

case "$tool" in
  Write|Edit|MultiEdit|NotebookEdit)
    fp=$(field file_path)
    case "$fp" in
      tests/qa/*|./tests/qa/*|*/tests/qa/*) exit 0 ;;
      *) echo "gg-qa may write only under tests/qa/ (got: $fp)" >&2; exit 2 ;;
    esac
    ;;
  Bash)
    cmd=$(field command | sed 's/\\"/"/g')
    bad=$(printf '%s\n' "$cmd" | tr ' ;&|()' '\n\n\n\n\n\n' | awk '
      /^-/ { next }
      /godot/ { next }
      /^(res:\/\/)?(\.\/)?tests\/qa(\/|$)/ { next }
      /^\/tmp\// { next }
      /\.\./ { print; next }
      /\// || /\.(gg|tscn|tres|md|godot|json|cfg)$/ { print }
    ' | head -3)
    if [ -n "$bad" ]; then
      echo "gg-qa may run only godot and touch tests/qa/. Blocked tokens: $(printf '%s' "$bad" | tr '\n' ' ')" >&2
      exit 2
    fi
    exit 0
    ;;
  *) exit 0 ;;
esac
